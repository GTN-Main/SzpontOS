export PATH=/bin:/usr/bin:/usr/tbin:/usr/local/bin:/sbin:/usr/sbin
export TERM=xterm-256color
export COLORTERM=truecolor
export ENV=/etc/shrc
export USER=${USER:-root}
export LOGNAME=${LOGNAME:-$USER}
export HOME=${HOME:-/root}
export SHELL=${SHELL:-/bin/sh}
export MAGIC=/etc/magic:/usr/share/misc/magic
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export XFILESEARCHPATH=/etc/X11/app-defaults/%N:/usr/share/X11/app-defaults/%N:/usr/lib/X11/app-defaults/%N
export XAPPLRESDIR=/etc/X11/app-defaults
export CROCUS_GEN8=1
export MESA_LOADER_DRIVER_OVERRIDE=crocus

# Source interactive shell configuration
if [ -f /etc/shrc ]; then
    . /etc/shrc
fi
