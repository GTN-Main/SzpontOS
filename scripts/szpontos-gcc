#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

filtered_args=()
has_shared=0

for arg in "$@"; do
    if [ "$arg" = "-pthread" ]; then
        filtered_args+=("-D_REENTRANT")
    elif [ "$arg" = "-shared" ]; then
        has_shared=1
        filtered_args+=("$arg")
    else
        filtered_args+=("$arg")
    fi
done

if [ "$has_shared" -eq 1 ]; then
    exec x86_64-elf-gcc "${filtered_args[@]}" -nostartfiles "$ROOT_DIR/build/sysroot/usr/lib/dso_handle.o" -Wl,-shared -Wl,-z,undefs
else
    exec x86_64-elf-gcc "${filtered_args[@]}"
fi
